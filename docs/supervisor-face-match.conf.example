[program:sm-face-match-worker]
process_name=%(program_name)s_%(process_num)02d
command=php D:/LAPTRINHWEB/DATN/SM/artisan queue:work redis --queue=face-match --sleep=3 --tries=3 --timeout=120
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
numprocs=2
redirect_stderr=true
stdout_logfile=D:/LAPTRINHWEB/DATN/SM/storage/logs/face-match-worker.log
stopwaitsecs=150

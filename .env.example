APP_NAME="TimKiemTreEmThatLac"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Ho_Chi_Minh

APP_LOCALE=vi
APP_FALLBACK_LOCALE=vi
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=missing_children_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

FACE_MATCH_SERVICE_URL=http://127.0.0.1:8001
FACE_MATCH_INTERNAL_KEY=
FACE_MATCH_SCORE_THRESHOLD=0.70
FACE_MATCH_HIGH_CONFIDENCE_THRESHOLD=0.85
FACE_MATCH_QUEUE=face-match


REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@timkiemtreem.vn"
MAIL_FROM_NAME="${APP_NAME}"

# ==================== AI MICRO SERVICE ====================
AI_SERVICE_URL=http://127.0.0.1:8001
AI_INTERNAL_KEY=supersecretkey1234567890changethisinproduction

EKYC_PROVIDER=tesseract
EKYC_QUEUE=kyc
TESSERACT_PATH="D:/app/tesseract.exe"

FPT_AI_API_KEY=
FPT_AI_BASE_URL=https://api.fpt.ai

VNPT_EKYC_TOKEN_ID=
VNPT_EKYC_TOKEN_KEY=
VNPT_EKYC_BASE_URL=

# ==================== GOOGLE OAUTH ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# ==================== FIREBASE CLOUD MESSAGING ====================
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
# Optional short-lived OAuth token for local testing only.
FIREBASE_ACCESS_TOKEN=

# ==================== REVERB (Realtime) ====================
REVERB_APP_ID=my-app-id
REVERB_APP_KEY=my-app-key
REVERB_APP_SECRET=my-app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ==================== SANCTUM ====================
SANCTUM_STATEFUL_DOMAINS=127.0.0.1,localhost

# ==================== OTHER ====================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

NOTIFICATION_ESCALATION_THRESHOLD_MINUTES=30
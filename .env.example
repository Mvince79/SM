############################################
# APP
############################################
APP_NAME="TìmTrẻ.vn"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.here
APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=Asia/Ho_Chi_Minh

BCRYPT_ROUNDS=12
DEBUGBAR_ENABLED=false

############################################
# LOG
############################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

############################################
# ERROR TRACKING / UPTIME (Sentry - F-01)
############################################
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=${APP_ENV}
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

############################################
# DATABASE (MySQL trên VPS - A-01/A-02)
############################################
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=timtre_production
DB_USERNAME=
DB_PASSWORD=

############################################
# CACHE / SESSION / QUEUE (Redis - A-03)
############################################
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.your-domain.here

QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=180
REDIS_QUEUE_BLOCK_FOR=5
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

############################################
# FILESYSTEM (lưu ảnh local trên VPS)
############################################
FILESYSTEM_DISK=public
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

############################################
# BROADCAST (Reverb realtime - Sprint 3)
############################################
BROADCAST_CONNECTION=reverb

############################################
# MAIL
############################################
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@your-domain.here"
MAIL_FROM_NAME="${APP_NAME}"

############################################
# GOOGLE OAUTH (đăng nhập Google)
############################################
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.here/auth/google/callback

############################################
# LARAVEL REVERB (Realtime Notification/Chat - Sprint 3)
############################################
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=your-domain.here
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

############################################
# AI FACE MATCH SERVICE (FastAPI/DeepFace - Sprint 3, deploy ở A-04)
# LƯU Ý: tên biến chuẩn code đang dùng là FACE_MATCH_SERVICE_URL,
# KHÔNG PHẢI AI_SERVICE_URL — xác nhận ngày 05/08/2026 qua grep code thật.
# (AI_SERVICE_URL / AI_INTERNAL_KEY từng tồn tại trong .env local nhưng
# không có code nào đọc tới — biến rác, KHÔNG cần khai báo ở đây)
############################################
FACE_MATCH_SERVICE_URL=http://127.0.0.1:8001
FACE_MATCH_INTERNAL_KEY=
FACE_MATCH_MODEL=ArcFace
FACE_MATCH_SCORE_THRESHOLD=0.7
FACE_MATCH_HIGH_CONFIDENCE_THRESHOLD=0.85
FACE_MATCH_TIMEOUT=30
FACE_MATCH_HEALTH_TIMEOUT=5
FACE_MATCH_QUEUE=default

############################################
# eKYC / OCR (Sprint 3.5 + Sprint 4 - K-02)
# Đang dùng Tesseract (OCR mã nguồn mở, chạy local, MIỄN PHÍ hoàn toàn).
# FPT.AI/VNPT là 2 lựa chọn dự phòng đã hỗ trợ trong code (Sprint 4) nhưng
# HIỆN KHÔNG DÙNG — để trống, chỉ cần điền nếu sau này đổi provider.
############################################
EKYC_PROVIDER=tesseract
EKYC_QUEUE=kyc
# QUAN TRỌNG (task A-01): VPS phải cài gói ngôn ngữ tiếng Việt cho Tesseract,
# nếu không sẽ đọc sai/đọc rỗng chữ trên CCCD/CMND:
#   sudo apt install tesseract-ocr tesseract-ocr-vie
TESSERACT_PATH=/usr/bin/tesseract

# --- Dự phòng, không dùng hiện tại ---
FPT_AI_API_KEY=
FPT_AI_BASE_URL=https://api.fpt.ai

VNPT_EKYC_TOKEN_ID=
VNPT_EKYC_TOKEN_KEY=
VNPT_EKYC_BASE_URL=

############################################
# FIREBASE (Push Notification)
############################################
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

############################################
# NGHIỆP VỤ RIÊNG DỰ ÁN
############################################
CHILD_AGE_LIMIT=16
NOTIFICATION_ESCALATION_THRESHOLD_MINUTES=30

############################################
# SANCTUM (API token cho mobile/Third-Party Verifier)
############################################
SANCTUM_STATEFUL_DOMAINS=your-domain.here

############################################
# GEMINI (Chatbot AI — trợ lý ảo nâng cấp)
# Gemini 3.6 Flash (free tier) hỗ trợ function calling.
# LƯU Ý: gemini-2.0-flash đã bị Google gỡ bỏ (HTTP 404) từ 2026 — dùng 3.6.
# Điền GEMINI_API_KEY thật vào file .env (KHÔNG để key thật trong .env.example).
# Lấy key tại: https://aistudio.google.com/apikey
############################################
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_TIMEOUT=10
